# Copy this file to .env and fill in the keys you want.
# The app runs in demo mode without any key.

# ---- Chat / text / translation (Mistral) ----
# Get a key: https://console.mistral.ai/
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=mistral-small-latest

# ---- Image generation (any OpenAI-compatible provider) ----
# Works with OpenAI (dall-e-3), Together AI (black-forest-labs/FLUX.1-schnell-Free), etc.
IMAGE_API_KEY=
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL=dall-e-3
IMAGE_SIZE=1024x1024

# ---- Video generation (Luma Dream Machine) ----
# Get a key: https://lumalabs.ai/api-access
VIDEO_API_KEY=
VIDEO_BASE_URL=https://api.lumalabs.ai/dream-machine/v1
VIDEO_MODEL=ray-2

# ---- Voice: text-to-speech (server-side, optional) ----
TTS_API_KEY=
TTS_BASE_URL=https://api.openai.com/v1
TTS_MODEL=tts-1
TTS_VOICE=alloy

# ---- Voice: speech-to-text (server-side, optional) ----
STT_API_KEY=
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1
